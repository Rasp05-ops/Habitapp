# Copy to .env  (cp .env.example .env). Keep comments on their own lines: "KEY=   # note" makes the note the value.

# dev = fixed OTP 123456, mock photo check, /docs enabled. Anything else is treated as PRODUCTION. NEVER use dev in production.
APP_ENV=dev

# PostgreSQL is required in production; leave empty only for local SQLite development.
DATABASE_URL=

# Production: python -c "import secrets;print(secrets.token_urlsafe(48))"  (the app refuses to start with a weak secret)
JWT_SECRET=dev-only-secret-never-use-in-production-0123456789

# Comma-separated list of allowed front-end origins
CORS_ORIGINS=http://localhost:5173

# Leave empty in dev to use the mock verifier. REQUIRED in production.
GEMINI_API_KEY=

# Check the current model name before launch
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated approved YouTube video IDs. They rotate one per IST day in the
# same order as STORIES in backend/app/rules.py.
STORY_VIDEO_IDS=
