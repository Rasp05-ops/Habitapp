    "gen:types": "openapi-typescript ../contract/openapi.yaml -o src/api/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "framer-motion": "^14.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
